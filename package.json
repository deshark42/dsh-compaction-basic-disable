{
  "name": "@local/dsh-compaction-basic-disable",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Disable DSH basic compaction without copying official preset configurations.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deshark42/dsh-compaction-basic-disable.git"
  },
  "homepage": "https://github.com/deshark42/dsh-compaction-basic-disable#readme",
  "bugs": {
    "url": "https://github.com/deshark42/dsh-compaction-basic-disable/issues"
  },
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json",
    "./dsh.bundle.patch.yml": "./dsh.bundle.patch.yml"
  },
  "files": [
    "src/index.js",
    "dsh.bundle.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.16"
  },
  "packageManager": "pnpm@12.8.1",
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:unit": "node --test test/policy.test.js",
    "test:integration": "node --test test/loader.test.js",
    "check": "node --check src/index.js && node --check test/policy.test.js && node --check test/loader.test.js && pnpm test"
  },
  "dsh": {
    "bundle": {
      "patch": "./dsh.bundle.patch.yml"
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5-alpha.2",
    "@deepseek-ai/cordis-plugin-include": "1.0.10-alpha.2",
    "@deepseek-ai/cordis-plugin-loader": "1.0.6-alpha.2",
    "@deepseek-ai/dsh-agent-preset": "0.2.1-alpha.3",
    "@deepseek-ai/dsh-command-compact": "0.2.1-alpha.3",
    "@deepseek-ai/dsh-compaction-basic": "0.2.1-alpha.3",
    "@deepseek-ai/dsh-web-app": "0.2.1-alpha.3",
    "js-yaml": "^4.1.0"
  }
}
